<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import org.baseplayer.components.ColoredToggle?>
<?import org.baseplayer.variant.ui.components.DualRangeSlider?>
<?import org.baseplayer.variant.ui.components.IntegerRangeSlider?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="org.baseplayer.variant.ui.VariantManagerController"
         styleClass="root-pane">

    <TabPane fx:id="filterTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="filter-tabs">

        <!-- Point mutations: filters + gene/intronic/intergenic tables -->
        <Tab fx:id="pointMutationsTab" text="Point mutations">
            <SplitPane fx:id="pointMainSplitPane" orientation="VERTICAL" dividerPositions="0.45"
                       styleClass="variant-manager-split">
                <SplitPane fx:id="variantFiltersSplitPane" dividerPositions="0.5" styleClass="tab-content-split">
                    <ScrollPane fitToWidth="true" styleClass="filter-scroll" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                        <VBox spacing="8" styleClass="filter-panel">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Point mutation filters" styleClass="panel-title"/>
                                <HBox fx:id="reloadBanner" spacing="6" alignment="CENTER_LEFT" visible="false"
                                      style="-fx-background-color: rgba(209,102,36,0.18); -fx-background-radius: 6; -fx-padding: 2 6 2 6;">
                                    <Label fx:id="reloadBannerLabel"
                                           text="Reload needed"
                                           style="-fx-text-fill: #f0c6a9; -fx-font-size: 11px;"/>
                                    <Button fx:id="reloadBannerButton" text="Reload" styleClass="secondary-button"
                                            style="-fx-font-size: 10px; -fx-padding: 1 6 1 6;"
                                            onAction="#handleReloadFilteredVariants"/>
                                </HBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="minimizeButton" text="−" styleClass="secondary-button"
                                        style="-fx-font-size: 12px; -fx-padding: 2 6 2 6;"
                                        onAction="#handleMinimize"/>
                            </HBox>
                            <Separator/>

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="QUAL" styleClass="section-header filter-slider-label"
                                       minWidth="36" prefWidth="36">
                                    <tooltip>
                                        <Tooltip text="Minimum variant quality (QUAL)"/>
                                    </tooltip>
                                </Label>
                                <Slider fx:id="qualitySlider" min="0" max="99" value="0"
                                        showTickLabels="false" showTickMarks="false"
                                        blockIncrement="5" prefWidth="350" HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="qualityField" text="0" prefWidth="52" styleClass="filter-field"/>
                                <Label fx:id="qualityValueLabel" text="0" visible="false" managed="false"/>
                            </HBox>

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="DP" styleClass="section-header filter-slider-label"
                                       minWidth="36" prefWidth="36">
                                    <tooltip>
                                        <Tooltip text="Minimum read depth (DP)"/>
                                    </tooltip>
                                </Label>
                                <Slider fx:id="coverageSlider" min="0" max="200" value="0"
                                        showTickLabels="false" showTickMarks="false"
                                        blockIncrement="10" prefWidth="350" HBox.hgrow="ALWAYS"/>
                                <TextField fx:id="coverageField" text="0" prefWidth="52" styleClass="filter-field"/>
                                <Label fx:id="coverageValueLabel" text="0" visible="false" managed="false"/>
                            </HBox>

                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="AF" styleClass="section-header filter-slider-label"
                                       minWidth="36" prefWidth="36">
                                    <tooltip>
                                        <Tooltip text="Allele fraction range — keep calls between min and max thumbs"/>
                                    </tooltip>
                                </Label>
                                <DualRangeSlider fx:id="alleleFreqRangeSlider" HBox.hgrow="ALWAYS"/>
                            </HBox>

                            <Separator/>

                            <VBox spacing="6">
                                <Label text="Custom filters" styleClass="section-header"/>
                                <VBox fx:id="advancedFiltersContainer" spacing="4"/>
                                <HBox spacing="8">
                                    <Button fx:id="addInfoFilterButton" text="Add custom filter"
                                            styleClass="secondary-button" onAction="#handleAddCustomFilter"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </ScrollPane>

                    <ScrollPane fitToWidth="true" styleClass="filter-scroll" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                        <VBox spacing="8" styleClass="filter-panel">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>

                            <VBox spacing="6" fillWidth="true">
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <ColoredToggle fx:id="selectAllTypesCheckBox" selected="true"/>
                                    <Label text="Variant Types" styleClass="section-header"/>
                                </HBox>
                                <FlowPane fx:id="variantTypesContainer" hgap="10" vgap="2" prefWrapLength="320"
                                          styleClass="filter-toggle-flow"/>
                            </VBox>

                            <Separator/>

                            <VBox spacing="6" fillWidth="true">
                                <HBox spacing="6" alignment="CENTER_LEFT">
                                    <ColoredToggle fx:id="selectAllEffectsCheckBox" selected="true"/>
                                    <Label text="Effect Categories" styleClass="section-header"/>
                                </HBox>
                                <FlowPane fx:id="effectCategoriesContainer" hgap="10" vgap="2" prefWrapLength="320"
                                          styleClass="filter-toggle-flow"/>
                            </VBox>

                            <Separator/>

                            <VBox spacing="6">
                                <Label text="Special Filters" styleClass="section-header"/>
                                <ColoredToggle fx:id="cancerOnlyCheckBox" text="Cancer genes only (COSMIC Census)"/>
                            </VBox>
                        </VBox>
                    </ScrollPane>
                </SplitPane>

                <VBox spacing="0" styleClass="variant-table-area">
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="variant-table-toolbar">
                    <padding>
                        <Insets top="4" right="8" bottom="4" left="8"/>
                    </padding>
                    <Button fx:id="annotateAllChromosomesButton" text="Annotate All Chromosomes"
                            styleClass="primary-button"
                            onAction="#handleAnnotateAllChromosomes"/>
                    <TextField fx:id="tableSearchField" promptText="Search genes, effects…"
                               styleClass="filter-field table-search-field"
                               prefWidth="180" maxWidth="180"/>
                    <Button fx:id="excelExportButton" styleClass="icon-button"
                            visible="false" managed="false"
                            onAction="#handleExportExcel"/>
                </HBox>
                <TabPane fx:id="resultsTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="results-tabs"
                         VBox.vgrow="ALWAYS">
                    <Tab fx:id="codingTab" text="Coding">
                        <StackPane styleClass="table-container">
                            <TableView fx:id="codingTable" styleClass="variant-table">
                                <columns>
                                    <TableColumn fx:id="codingGeneColumn" text="Gene" prefWidth="130"/>
                                    <TableColumn fx:id="codingPositionColumn" text="Position" prefWidth="150"/>
                                    <TableColumn fx:id="codingRefAltColumn" text="Ref → Alt" prefWidth="90"/>
                                    <TableColumn fx:id="codingTypeColumn" text="Type" prefWidth="65"/>
                                    <TableColumn fx:id="codingEffectColumn" text="Effect" prefWidth="120"/>
                                    <TableColumn fx:id="codingAaChangeColumn" text="AA Change" prefWidth="120"/>
                                    <TableColumn fx:id="codingCodonChangeColumn" text="Codon Change" prefWidth="110"/>
                                    <TableColumn fx:id="codingSamplesColumn" text="Samples" prefWidth="70"/>
                                    <TableColumn fx:id="codingQualityColumn" text="Max GQ" prefWidth="70"/>
                                </columns>
                            </TableView>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="intronicTab" text="Intronic">
                        <StackPane styleClass="table-container">
                            <TableView fx:id="intronicTable" styleClass="variant-table">
                                <columns>
                                    <TableColumn fx:id="intronicGeneColumn" text="Gene" prefWidth="130"/>
                                    <TableColumn fx:id="intronicPositionColumn" text="Position" prefWidth="150"/>
                                    <TableColumn fx:id="intronicRefAltColumn" text="Ref → Alt" prefWidth="90"/>
                                    <TableColumn fx:id="intronicTypeColumn" text="Type" prefWidth="65"/>
                                    <TableColumn fx:id="intronicSamplesColumn" text="Samples" prefWidth="70"/>
                                    <TableColumn fx:id="intronicQualityColumn" text="Max GQ" prefWidth="70"/>
                                </columns>
                            </TableView>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="intergenicTab" text="Intergenic">
                        <StackPane styleClass="table-container">
                            <TableView fx:id="intergenicTable" styleClass="variant-table">
                                <columns>
                                    <TableColumn fx:id="intergenicGeneColumn" text="Gene" prefWidth="130"/>
                                    <TableColumn fx:id="intergenicPositionColumn" text="Position" prefWidth="150"/>
                                    <TableColumn fx:id="intergenicRefAltColumn" text="Ref → Alt" prefWidth="90"/>
                                    <TableColumn fx:id="intergenicTypeColumn" text="Type" prefWidth="65"/>
                                    <TableColumn fx:id="intergenicSamplesColumn" text="Samples" prefWidth="70"/>
                                    <TableColumn fx:id="intergenicQualityColumn" text="Max GQ" prefWidth="70"/>
                                </columns>
                            </TableView>
                        </StackPane>
                    </Tab>
                    <!-- LOH regions: sibling of Coding / Intronic / Intergenic -->
                    <Tab fx:id="lohRegionsTab" text="LOH">
                        <TabPane fx:id="lohResultsTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="results-tabs">
                            <Tab fx:id="lohAllTab" text="All">
                                <StackPane styleClass="table-container">
                                    <TableView fx:id="lohAllTable" styleClass="variant-table"/>
                                </StackPane>
                            </Tab>
                            <Tab fx:id="lohAaTab" text="LOH AA">
                                <StackPane styleClass="table-container">
                                    <TableView fx:id="lohAaTable" styleClass="variant-table"/>
                                </StackPane>
                            </Tab>
                            <Tab fx:id="lohBbTab" text="LOH BB">
                                <StackPane styleClass="table-container">
                                    <TableView fx:id="lohBbTable" styleClass="variant-table"/>
                                </StackPane>
                            </Tab>
                        </TabPane>
                    </Tab>
                </TabPane>
                </VBox>
            </SplitPane>
        </Tab>

        <!-- Structural variants: filters host + SV tables (filters built in code) -->
        <Tab fx:id="structuralVariantsTab" text="Structural variants">
            <SplitPane fx:id="svMainSplitPane" orientation="VERTICAL" dividerPositions="0.45"
                       styleClass="variant-manager-split">
                <VBox fx:id="svFiltersHost" spacing="0" styleClass="filter-panel"/>
                <VBox spacing="0" styleClass="variant-table-area">
                <HBox spacing="8" alignment="CENTER_LEFT" styleClass="variant-table-toolbar">
                    <padding>
                        <Insets top="4" right="8" bottom="4" left="8"/>
                    </padding>
                    <Button fx:id="svAnnotateAllChromosomesButton" text="Annotate All Chromosomes"
                            styleClass="primary-button"
                            onAction="#handleAnnotateAllChromosomes"/>
                    <TextField fx:id="svTableSearchField" promptText="Search genes, positions, mates…"
                               styleClass="filter-field table-search-field"
                               prefWidth="180" maxWidth="180"/>
                    <Button fx:id="svExcelExportButton" styleClass="icon-button"
                            visible="false" managed="false"/>
                </HBox>
                <TabPane fx:id="svResultsTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="results-tabs"
                         VBox.vgrow="ALWAYS">
                    <Tab fx:id="svAllTab" text="All">
                        <StackPane styleClass="table-container">
                            <TableView fx:id="svAllTable" styleClass="variant-table"/>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="svDelTab" text="DEL">
                        <StackPane styleClass="table-container">
                            <TableView fx:id="svDelTable" styleClass="variant-table"/>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="svDupTab" text="DUP">
                        <StackPane styleClass="table-container">
                            <TableView fx:id="svDupTable" styleClass="variant-table"/>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="svCnvGainTab" text="Gain">
                        <StackPane styleClass="table-container">
                            <TableView fx:id="svCnvGainTable" styleClass="variant-table"/>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="svCnvLossTab" text="Loss">
                        <StackPane styleClass="table-container">
                            <TableView fx:id="svCnvLossTable" styleClass="variant-table"/>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="svCnvNeutralTab" text="Neutral">
                        <StackPane styleClass="table-container">
                            <TableView fx:id="svCnvNeutralTable" styleClass="variant-table"/>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="svInvTab" text="INV">
                        <StackPane styleClass="table-container">
                            <TableView fx:id="svInvTable" styleClass="variant-table"/>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="svTraTab" text="TRA">
                        <StackPane styleClass="table-container">
                            <TableView fx:id="svTraTable" styleClass="variant-table"/>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="svBndTab" text="BND">
                        <StackPane styleClass="table-container">
                            <TableView fx:id="svBndTable" styleClass="variant-table"/>
                        </StackPane>
                    </Tab>
                    <Tab fx:id="svInsTab" text="INS">
                        <StackPane styleClass="table-container">
                            <TableView fx:id="svInsTable" styleClass="variant-table"/>
                        </StackPane>
                    </Tab>
                </TabPane>
                </VBox>
            </SplitPane>
        </Tab>

        <Tab text="Sample Comparison">
            <SplitPane fx:id="sampleComparisonSplitPane" dividerPositions="0.5" styleClass="tab-content-split">
                <ScrollPane fitToWidth="true" styleClass="filter-scroll" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                    <VBox spacing="8" styleClass="filter-panel">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <VBox spacing="6">
                            <Label text="Common variants" styleClass="section-header"/>
                            <Label fx:id="commonVariantsHelpLabel" text="Shared-sample range (min–max)."
                                   styleClass="subsection-label" wrapText="true"/>
                            <ColoredToggle fx:id="geneLevelComparisonCheckBox" text="Gene level"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Window (bp)" styleClass="subsection-label" minWidth="80"/>
                                <TextField fx:id="comparisonWindowField" text="0" prefWidth="72" maxWidth="90" styleClass="filter-field"/>
                                <Button fx:id="comparisonWindowApplyButton" text="Apply" styleClass="secondary-button"
                                        minWidth="64" maxWidth="Infinity"/>
                            </HBox>
                            <IntegerRangeSlider fx:id="sharedSampleRangeSlider"/>
                        </VBox>
                    </VBox>
                </ScrollPane>

                <ScrollPane fitToWidth="true" styleClass="filter-scroll" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                    <VBox spacing="8" styleClass="filter-panel">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <VBox spacing="6" VBox.vgrow="ALWAYS">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="Sample tags" styleClass="section-header"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="refreshComparisonGroupsButton" text="Refresh" styleClass="secondary-button"
                                        minWidth="72" onAction="#handleRefreshComparisonGroups"/>
                            </HBox>
                            <VBox fx:id="comparisonGroupsContainer" spacing="6" VBox.vgrow="ALWAYS"/>
                            <Label fx:id="groupComparisonSummaryLabel" text="No tag constraints" styleClass="value-label" wrapText="true"/>
                        </VBox>
                        <Separator/>
                        <VBox spacing="6">
                            <Label text="Multi-tag match" styleClass="section-header"/>
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <RadioButton fx:id="presentMatchAllRadio" text="All (AND)" selected="true" styleClass="filter-radio"/>
                                <RadioButton fx:id="presentMatchAnyRadio" text="Any (OR)" styleClass="filter-radio"/>
                            </HBox>
                        </VBox>
                        <Separator/>
                        <HBox spacing="12" alignment="CENTER_RIGHT">
                            <padding>
                                <Insets top="4"/>
                            </padding>
                            <Button fx:id="calculateLohButton" text="Calculate LOH"
                                    styleClass="secondary-button" disable="true" minWidth="110"
                                    onAction="#handleCalculateLohRegions"/>
                            <Button text="Apply" styleClass="primary-button" minWidth="64"
                                    onAction="#handleApplyComparison"/>
                        </HBox>
                    </VBox>
                </ScrollPane>
            </SplitPane>
        </Tab>

        <Tab text="Control Files">
            <VBox fx:id="controlFilesRoot" spacing="0">
                <SplitPane fx:id="controlFilesSplitPane" dividerPositions="0.55" styleClass="tab-content-split"
                           VBox.vgrow="ALWAYS">
                    <ScrollPane fitToWidth="true" styleClass="filter-scroll"
                                hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                        <VBox spacing="12" styleClass="filter-panel">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            <Label text="Control file" styleClass="section-header"/>
                            <Label fx:id="controlFilePathLabel" text="No control file loaded"
                                   styleClass="value-label" wrapText="true"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Button fx:id="addControlVcfButton" text="Add VCF" styleClass="secondary-button"
                                        onAction="#handleAddControlVcf"/>
                                <Button fx:id="removeControlFileButton" text="Remove" styleClass="secondary-button"
                                        disable="true" onAction="#handleRemoveControlFile"/>
                            </HBox>

                            <Separator/>

                            <Label text="Allele frequency filter" styleClass="section-header"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <ColoredToggle fx:id="filterByPopFreqCheckBox" text="Filter by control allele frequency"/>
                                <Label text="Max AF:" styleClass="subsection-label"/>
                                <TextField fx:id="maxPopFreqField" text="0.01" prefWidth="80" styleClass="filter-field"/>
                            </HBox>
                        </VBox>
                    </ScrollPane>
                    <ScrollPane fitToWidth="true" styleClass="filter-scroll"
                                hbarPolicy="NEVER" vbarPolicy="AS_NEEDED">
                        <VBox spacing="12" styleClass="filter-panel">
                            <padding>
                                <Insets top="16" right="16" bottom="16" left="16"/>
                            </padding>
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <ColoredToggle fx:id="selectAllPopulationsCheckBox" selected="true" disable="true"/>
                                <Label text="Populations" styleClass="section-header"/>
                            </HBox>
                            <Label text="Only checked populations contribute AF. Apply to annotate with their max AF."
                                   styleClass="subsection-label" wrapText="true"/>
                            <VBox fx:id="controlPopulationBox" spacing="4" disable="true"/>
                        </VBox>
                    </ScrollPane>
                </SplitPane>
                <Separator/>
                <HBox spacing="12" alignment="CENTER_RIGHT" styleClass="filter-panel">
                    <padding>
                        <Insets top="8" right="16" bottom="12" left="16"/>
                    </padding>
                    <Button text="Apply" styleClass="primary-button" onAction="#handleApplyControlSettings"/>
                </HBox>
            </VBox>
        </Tab>
    </TabPane>

    <HBox fx:id="minimizedPane" visible="false" managed="false" spacing="8" alignment="CENTER_LEFT"
          style="-fx-background-color: #2d2d2d; -fx-border-color: #555; -fx-border-width: 1; -fx-padding: 4 8 4 8; -fx-background-radius: 4;">
        <StackPane.alignment>TOP_LEFT</StackPane.alignment>
        <StackPane.margin>
            <Insets top="8" left="8"/>
        </StackPane.margin>
        <Label text="Variant Manager" style="-fx-text-fill: #cccccc; -fx-font-size: 11px; -fx-font-weight: bold;"/>
        <Button fx:id="minimizedExpandButton" text="▲" styleClass="secondary-button"
                style="-fx-font-size: 9px; -fx-padding: 2 6 2 6;"
                onAction="#handleExpandMinimized"/>
    </HBox>

    <!-- Busy dimmer; spinner + status shown during gene annotation. -->
    <VBox fx:id="loadingModal" visible="false" managed="false"
          alignment="CENTER" spacing="12"
          mouseTransparent="false"
          style="-fx-background-color: rgba(0, 0, 0, 0.55);">
        <ProgressIndicator fx:id="loadingSpinner" prefWidth="48" prefHeight="48"
                           maxWidth="48" maxHeight="48"
                           progress="-1" visible="false" managed="false"
                           style="-fx-progress-color: #5a9fd4;"/>
        <Label fx:id="loadingStatusLabel" text="Annotating"
               visible="false" managed="false"
               style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;"/>
    </VBox>
</StackPane>
